# Copy this file to .env (gitignored) and fill in values before running docker-compose up.
# NEVER commit .env with real credentials.

# InfluxDB — set a strong random password and token (min 32 characters for the token)
INFLUXDB_ADMIN_PASSWORD=change-me-strong-password
INFLUXDB_ADMIN_TOKEN=change-me-random-token-at-least-32-chars

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
